# ---- backend ----
PORT=5000
# Optional: when set, backend uses Supabase instead of the in-memory store
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional: when set, AI Coach calls an OpenAI-compatible chat API.
# Without a key the deterministic fallback is used (demo works offline).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- frontend ----
VITE_API_URL=http://localhost:5000/api
